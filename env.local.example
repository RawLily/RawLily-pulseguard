# Auth0 Configuration (Dev)
AUTH0_SECRET=use [openssl rand -hex 32] to generate a 32 bytes value
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id_dev
AUTH0_CLIENT_SECRET=your_auth0_client_secret_dev

# Database Configuration (Neon PostgreSQL - Dev)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/pulseguard_dev?sslmode=require

# Stripe Configuration (Test Mode - pk_test_ / sk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxxxx
STRIPE_PRICE_ID_MONTHLY=price_test_xxxxx
STRIPE_PRICE_ID_YEARLY=price_test_xxxxx

# Resend Email Configuration (Test)
RESEND_API_KEY=re_test_xxxxx

# Sentry Error Tracking (Dev)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_ENVIRONMENT=development

# Application Configuration (Local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Security & Encryption (Dev Keys)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: Analytics (Dev)
NEXT_PUBLIC_GA_ID=G-dev_xxxxx

# Optional: Slack Integration (Dev)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/dev_xxxxx

# Dev-only: Verbose Logging
DEBUG=pulseguard:*
