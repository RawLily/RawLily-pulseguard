# Auth0 Configuration
AUTH0_SECRET=your_random_secret_key_here_minimum_32_characters
AUTH0_BASE_URL=https://pulseguardhq.xyz
AUTH0_ISSUER_BASE_URL=https://your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/pulseguard?sslmode=require

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx or pk_test_xxxxx
STRIPE_SECRET_KEY=sk_live_xxxxx or sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_ID_MONTHLY=price_xxxxx
STRIPE_PRICE_ID_YEARLY=price_xxxxx
STRIPE_PRICE_ID_MONTHLY_STARTER=price_xxxxx
STRIPE_PRICE_ID_YEARLY_STARTER=price_xxxxx

# Resend Email Configuration
RESEND_API_KEY=re_xxxxx

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Application URLs
NEXT_PUBLIC_APP_URL=https://pulseguardhq.xyz

# Encryption & JWT
ENCRYPTION_KEY=your_32_character_hex_encryption_key_here
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters

# Environment
NODE_ENV=production

# Optional: Analytics
NEXT_PUBLIC_GA_ID=G-xxxxx

# Optional: Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx

# Optional: Sentry Environment Tag
SENTRY_ENVIRONMENT=production
